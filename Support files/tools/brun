#!/bin/bash
# usage: brun "command" [timeout] [regex] -- run a shell command in the build VM (prompt BUILD# )
cd "/Volumes/Files/Claude Work Area/LLMOS/Support files"
LOGDIR=${LLMOS_LOGDIR:-${TMPDIR:-/tmp}/llmos-build}
python3 tools/vmctl.py run run/bser.sock "$LOGDIR/build-serial.log" "$1" "${3:-BUILD# \$}" "${2:-60}" | sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r//g'

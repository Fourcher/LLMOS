#!/bin/bash
# run a shell command inside the arm64 test VM's console and wait for its end
# marker; the marker is typed as DONE_""nnn (echo shows the quotes, the shell
# prints it without), so the typed line can never satisfy the wait itself.
# At the LLM OS console a command needs the "!" escape; at the plain test
# shell (LLMOS_TESTSHELL boots, prompt "llmos:/#") it does not: whichever
# prompt appeared last in the log decides.
cd "/Volumes/Files/Claude Work Area/LLMOS/Support files"
N=$RANDOM$RANDOM
P=$(tail -c 4000 run/boot-serial.log 2>/dev/null | tr -d '\r' | sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' | grep -aoE 'llmos:[^ ]*# |› ' | tail -1)
case "$P" in llmos:*) P='' ;; *) P='!' ;; esac
python3 tools/vmctl.py run run/tser.sock run/boot-serial.log "$P$1; echo; echo DONE_\"\"$N" "^DONE_$N" "${2:-120}" --quiet 1 --fast | sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r//g' | grep -vE "^\s*$|DONE_|^78|^!|LLM OS$|Ministral 3 3B ·|^llmos:[^ ]*# *$"

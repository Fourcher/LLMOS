#!/bin/sh
# Start the graphical desk on this screen: seat daemon -> labwc compositor
# -> the desk application. Falls back to the text console if the graphical
# stack is missing. Everything renders on the CPU when there is no 3D
# acceleration (a virtual machine); on real graphics hardware Mesa is used.
export HOME=/root LANG=C.UTF-8 PYTHONUNBUFFERED=1
# caches (fontconfig, Mesa's shader cache, Python) live outside the passphrase vault: a cache file
# mapped from inside it would keep the vault from closing when the owner locks
export XDG_CACHE_HOME=/var/cache/llmos XDG_CONFIG_HOME=/var/cache/llmos MESA_SHADER_CACHE_DIR=/var/cache/llmos/mesa
mkdir -p /var/cache/llmos/mesa
rm -f /var/cache/llmos/labwc/rc.xml   # a lock-screen keybind profile left by a crash must not outlive the lock
export XDG_RUNTIME_DIR=/run/llmos
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
export XDG_CONFIG_DIRS=/etc/xdg XDG_DATA_DIRS=/usr/share:/usr/local/share
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=wlroots   # (the screen-sharing portal for calls looks for it)
# GTK and WebKit look for a settings portal at start-up and wait for it to time out; there is none here.
# The accessibility bus (AT-SPI) is NOT disabled: native programs publish their buttons and fields on it, and
# control.py presses them there before it falls back to reading the screen. (Earlier builds set GTK_A11Y=none
# and NO_AT_BRIDGE=1 to skip the bus; the bus is now started below, so there is nothing to wait for.)
export GTK_USE_PORTAL=0
A11Y_ENV=/run/llmos/a11y.env   # the session bus address, read by control.py (the agent process cannot see this bus otherwise)
rm -f "$A11Y_ENV"

gpu=""
for c in /sys/class/drm/card0 /sys/class/drm/card1; do
    [ -e "$c/device/driver" ] && gpu=$(basename "$(readlink "$c/device/driver")") && break
done
case "$gpu" in
    virtio_gpu|virtio-pci|bochs-drm|cirrus|vmwgfx|simple-framebuffer|"")
        export WLR_RENDERER=pixman GSK_RENDERER=cairo LIBGL_ALWAYS_SOFTWARE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 ;;
    *)
        export GSK_RENDERER=ngl ;;
esac

if ! command -v labwc >/dev/null 2>&1 || ! python3 -c "import gi; gi.require_version('WebKit','6.0'); from gi.repository import WebKit" 2>/dev/null; then
    exec /usr/bin/llmos console
fi
rm -f /run/seatd.sock
mkdir -p /run/llmos; : >> /run/llmos/desk.log; chmod 600 /run/llmos/desk.log
# a private session bus for the desk (GTK/WebKit expect one; nothing else uses it)
if command -v dbus-run-session >/dev/null 2>&1; then
    # inside the session bus: publish its address for control.py, start the AT-SPI registry (org.a11y.Bus, so GTK and
    # WebKit programs can publish their windows), then run the compositor. The address file goes when the session ends.
    dbus-run-session -- sh -c '
        printf "DBUS_SESSION_BUS_ADDRESS=%s\n" "$DBUS_SESSION_BUS_ADDRESS" > '"$A11Y_ENV"'
        [ -x /usr/libexec/at-spi-bus-launcher ] && /usr/libexec/at-spi-bus-launcher --launch-immediately >/dev/null 2>&1 &
        seatd-launch -- labwc -s "/usr/bin/llmos desk-app 2>>/run/llmos/desk.log"
        rm -f '"$A11Y_ENV"'
    '
    exit $?
fi
exec seatd-launch -- labwc -s "/usr/bin/llmos desk-app 2>>/run/llmos/desk.log"

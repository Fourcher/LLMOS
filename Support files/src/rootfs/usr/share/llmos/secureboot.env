# x86-64 only: the boot chain every PC with Secure Boot on already trusts, taken from Debian 13 (trixie).
#   shim     signed by Microsoft (both the UEFI CA 2011 and the UEFI CA 2023, so old and new PCs accept it)
#   GRUB     signed by Debian: gcdx64 for the USB stick / ISO, grubx64 for an installed system
#   kernel   signed by Debian, with every module signed (Secure Boot's lockdown loads only signed modules)
# With these, a PC starts LLM OS with Secure Boot left on: no firmware settings, no key to enroll, and no
# BitLocker recovery prompt for a Windows on the same PC.
#
# tools/fetch-secureboot.sh downloads each file from https://deb.debian.org/ into build/cache; the build
# (src/install.sh) checks each against the SHA-256 here (taken from Debian's signed package index) before use.
# Each line: archive path, SHA-256.
SB_KVER=6.12.111+deb13-amd64
SB_DEBS="
debian/pool/main/s/shim-signed/shim-signed_1.51~1+deb13u1+16.1-2~deb13u1_amd64.deb 3c802fa303c0e6bf126adee74028d1042e3120360d159c2c05181dc9b2f61005
debian/pool/main/s/shim-helpers-amd64-signed/shim-helpers-amd64-signed_1+16.1+2~deb13u1_amd64.deb 7e950d75d5a40ecc0a99f727452ce35780b47a04d9a2cc3b1ff7c2bb316c033e
debian/pool/main/g/grub-efi-amd64-signed/grub-efi-amd64-signed_1+2.12+9+deb13u2_amd64.deb da8bb31308a3682a7d9343fc42bf7f603ad85bb5483eeb3ece23e2f1be2e9bbd
debian-security/pool/updates/main/l/linux-signed-amd64/linux-image-6.12.111+deb13-amd64_6.12.111-1_amd64.deb 792e7a407f8f39fa0db3deeb6cda4e4bb56042963376133a072856b1c685d4f3
"

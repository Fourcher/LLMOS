# Which model and voice files the installer fetches and verifies for the
# shipped image. The catalog (catalog.json) has every selectable model; this is
# just the one that ships pre-installed so the OS works the moment it boots.
# Hermes 3 3B is the small model a 4 GB machine can run, and the one the tier
# list recommends there. Dolphin, then Huihui, are preferred once they are
# installed and fit (models.active); they are too big to ship as the default.
MODEL_FILE=Hermes-3-Llama-3.2-3B.Q4_K_M.gguf
MODEL_SHA256=91776fe0f6cd7483d9d5e06162fdd1f8f0262c15ced269791b4d96a655e8a5a2
WHISPER_FILE=ggml-base.bin
WHISPER_SHA256=60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe
# Search by meaning (EmbeddingGemma 2) needs a llama.cpp newer than Alpine's package: built here from this exact
# upstream commit (github.com/ggml-org/llama.cpp), with every CPU variant so it runs on old and new processors alike.
EMBED_LLAMA_COMMIT=c479922ac520a08969b4c1dc154d7bbb3c386d85

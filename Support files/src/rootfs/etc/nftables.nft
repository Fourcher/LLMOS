#!/usr/sbin/nft -f
# generated by LLM OS -- edit through settings, not by hand
flush ruleset
table inet llmos {
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    ip protocol icmp icmp type { echo-reply, destination-unreachable, time-exceeded } accept
    ip6 nexthdr icmpv6 accept
    udp sport 67 udp dport 68 accept
    # Tailscale SSH arrives on tailscale0 (the daemon, not sshd). Direct WireGuard uses UDP 41641.
    iifname "tailscale0" accept
    udp dport 41641 accept
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
  }
  chain output {
    type filter hook output priority 0; policy accept;
    oif lo accept
    ct state established,related accept
    udp sport 68 udp dport 67 accept
  }
}
